# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is gitignored.

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Hugging Face (access tokens → new token, read role)
HF_API_KEY=your-hf-api-key
# Optional: override the free embedding model (384-dim, keep in sync with migrations)
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: override the resume-coach chat model (served via the Inference Providers router)
HF_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Resend (free tier transactional email) — optional in local dev
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=SkillMatch <onboarding@resend.dev>

# Sentry (free tier) — optional
SENTRY_DSN=your-sentry-dsn

# Public site URL (used for links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
